<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <script src="~/bootstrap/js/bootstrap.bundle.js"></script>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2> Inline forms </h2>
                <form>
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <label class="visually-hidden" for="inputEmail">Email</label> 
                            <input type="email"  class="form-control" />
                        </div>
                        <div class="col-auto">
                            <label class="visually-hidden" for="inputPassword">
                                Password
                            </label>
                            <input type="password" class="form-control" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                Sign
                                in
                            </button>
                        </div>
                    </div>
                </form>
                        <br />

               <h2> Horizontal Form </h2>
                <form>
                    <div class="row mb-3">
                        <label for="inputEmail" class="col-sm-2 col-formlabel">
                            First Name
                        </label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control"   id="inputEmail"  />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail" class="col-sm-3 col-formlabel">
                            Last Name
                        </label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="inputEmail" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail" class="col-sm-3 col-formlabel">
                            Email
                        </label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control" id="inputEmail" />
                        </div>
                    </div>
                    <div>
                        <input type="submit" value="Save" />
                    </div>
                 </form>

                <h2> Vertical Form </h2>
                <form>
                    <div class="mb-3">
                        <label class="form-label" for="inputEmail">Email</label>
                        <input type="email" class="form-control" id="inputEmail"
                               placeholder="Email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="firstname">First Name</label>
                        <input type="text" class="form-control" id="inputEmail"
                               placeholder="Last Name">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="firstname">Last Name</label>
                        <input type="text" class="form-control" id="inputEmail"
                               placeholder="Last Name">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="inputPassword"> Password</label>
                        <input type="password" class="form-control" id="inputPassword"
                               placeholder="Password">
                    </div>
                    <button type="submit" class="btn btn-primary">Sign in</button>
                </form>


            </div>
        </div>
    </div>
</body>
</html>