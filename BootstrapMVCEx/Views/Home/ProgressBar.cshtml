<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <script src="~/bootstrap/js/bootstrap.bundle.js"></script>
</head>
<body>
    <div class="container">
        <div class="row">
             <div class="col-md-12">
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/"> Home </a></li>
                    <li class="breadcrumb-item"><a href="/"> About </a></li>
                    <li class="breadcrumb-item"><a href="/"> Contact </a></li>
                    <li class="breadcrumb-item"><a href="/"> Services </a></li>
                </ul>
                 <br />
                  <ul class="pagination">
                      <li class="page-item"><a class="page-link" href="/"> Home </a></li>
                    <li class="page-item"><a class="page-link" href="/"> About </a></li>
                    <li class="page-item"><a class="page-link" href="/"> Contact </a></li>
                    <li class="page-item"><a class="page-link" href="/"> Services </a></li>
                  </ul>
             </div>
        </div>
       <div class="row">
            <div class="col-md-12">

                <button class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm"></span>
                </button>
                <button class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm"></span>
                    Loading..
                </button>

                <br />
                <div class="spinner-grow text-primary">
                     
                </div>

                <div class="spinner-grow text-danger">
                </div>

                <div class="spinner-grow text-success">
                </div>

                <br />
                <div class="spinner-border text-danger">

                </div>

                <div class="spinner-border text-info">

                </div>
                <div class="spinner-border text-warning">
                </div>

                <br />
                <div class="progress">
                    <div class="progress-bar" style="width:50%">
                         50% completed 
                    </div>
                </div>
                <br />
                <div class="progress">
                    <div class="progress-bar bg-success" style="width:20%">
                        20% completed
                    </div>
                </div>
                <br />
                <div class="progress">
                    <div class="progress-bar bg-info" style="width:80%">
                        80% completed
                    </div>
                </div>

                <br />

                <div class="progress">
                    <div class="progress-bar bg-danger progress-bar-striped" style="width:80%">
                        80% completed
                    </div>
                </div>
                <br />

                <div class="progress">
                    <div class="progress-bar-animated progress-bar bg-danger progress-bar-striped" style="width:80%">
                        80% completed
                    </div>
                </div>

                <br />

                <div class="progress">
                    <div class="progress-bar bg-success" style="width:40%">
                        Free Space
                    </div>
                    <div class="progress-bar bg-warning" style="width:10%">
                        Warning
                    </div>
                    <div class="progress-bar bg-danger"  style="width:20%">
                        Danger
                    </div>
                </div>
            </div>
       </div>
    </div>
